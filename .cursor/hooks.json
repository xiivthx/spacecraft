{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/check-main-write.sh",
        "matcher": "git\\s+",
        "failClosed": true
      },
      {
        "command": ".cursor/hooks/check-ship-commands.sh",
        "matcher": "git\\s+(merge|push|tag)\\b",
        "failClosed": true
      }
    ]
  }
}
